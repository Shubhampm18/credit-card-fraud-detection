# ==========================================================================
# .gitignore for the Credit Card Fraud Detection + Monitoring project
#
# Rule of thumb: source code, the trained model, the baseline reference and
# the small working sample are tracked; raw data, tests, caches, generated
# monitoring output, logs and secrets are NOT.
# ==========================================================================

# --------------------------------------------------------------------------
# Test suite (kept locally, never published)
# --------------------------------------------------------------------------
tests/
# Test-specific generated outputs / caches anywhere in the tree
.pytest_cache/
.tox/
.nox/
coverage.xml
.coverage
coverage.*
htmlcov/
*.cover
*_test_output/
test_results/
junit*.xml

# --------------------------------------------------------------------------
# Python caches and bytecode
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytype/
.python-version

# --------------------------------------------------------------------------
# Virtual environments / packaging
# --------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.conda/
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/

# --------------------------------------------------------------------------
# Raw datasets (must be downloaded; never commit)
# 143.8 MB creditcard.csv exceeds GitHub's 100 MB regular-file limit anyway.
# --------------------------------------------------------------------------
creditcard.csv
*.csv.bz2
*.zip
*.tar.gz
# Any additional raw dataset drops, but NOT the small tracked sample:
data/*
!data/creditcard_sample_5000.csv
!data/sample_metadata.json

# --------------------------------------------------------------------------
# Generated monitoring output and experiment results
#  - monitoring logs grow per run and contain timestamps/request IDs
#  - plots are regenerated by the scripts
# The fixed baseline is TRACKED (required to run monitoring/API).
# --------------------------------------------------------------------------
results/monitoring/
results/plots/
results/*.log

# --------------------------------------------------------------------------
# Logs and temporary files
# --------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~
*.orig
*.rej

# --------------------------------------------------------------------------
# Local environment / config overrides
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.local.json
local.settings.json
settings.local.py
config.local.*
secrets.*
*credentials*.json
service-account*.json
*service_account*.json

# --------------------------------------------------------------------------
# Credentials, tokens and secrets
# --------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
.id_token
.token
tokens.json
gcloud/
.aws/
.azure/
.docker/config.json
google-cloud-sdk/

# --------------------------------------------------------------------------
# API request logs (contain request IDs / timestamps) - see monitoring rules
# --------------------------------------------------------------------------
api_requests.csv
api_requests.jsonl
api_load_test_*.csv
api_load_test_*.json

# --------------------------------------------------------------------------
# Editors / OS
# --------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------------------------
# Misc
# --------------------------------------------------------------------------
status_report.txt
*summary_report*.txt